# Copy to .env and edit. NEVER commit your real .env (it is gitignored).

# --- Mode -------------------------------------------------------------------
# true  = synthetic demo data only, nothing touches a real inbox (default, safe)
# false = enable the optional read-only Gmail source below
DEMO_MODE=true

# --- Database ---------------------------------------------------------------
# Defaults to a local SQLite file. Point at Postgres for production:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/inbox
# DATABASE_URL=sqlite:///./data/inbox.db

# --- Categorization ---------------------------------------------------------
# Local sentence-transformers model (used only if the [ml] extra is installed;
# otherwise a deterministic hashing embedder is used automatically).
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# RULE_CONFIDENCE_THRESHOLD=0.80

# --- Optional Gmail (read-only; only read when DEMO_MODE=false) --------------
# Use a Gmail App Password (Account → Security → App passwords), NOT your login.
# GMAIL_ADDRESS=you@gmail.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# GMAIL_FETCH_LIMIT=200

# --- Frontend ---------------------------------------------------------------
# CORS_ORIGINS=["http://localhost:3000"]
