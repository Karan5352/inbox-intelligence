# Copy to .env.local for the frontend.

# Where the browser sends API calls. Default "/api" is proxied to the backend
# by next.config.mjs (good for local dev). In production point straight at the API:
# NEXT_PUBLIC_API_BASE=https://your-api.up.railway.app

# Backend origin the Next dev proxy forwards /api/* to (server-side only):
# API_PROXY_TARGET=http://localhost:8000
